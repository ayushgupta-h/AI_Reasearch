# ─────────────────────────────────────────────────────────────────────────────
# Research AI Quest — environment template
#
# Copy to `backend/.env` (preferred) or the repository-root `.env` and fill in
# real values. Never commit the real file: `.env` is git-ignored.
#
#   cp .env.example backend/.env
#
# Backend loads `backend/.env` first, then the repository-root `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | staging | production   (production refuses to start without
# an LLM key and a SHARE_SECRET)
APP_ENV=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8123,http://127.0.0.1:8123,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
# Optional log file, e.g. logs/app.log (leave blank to log to stderr only)
LOG_FILE=

# ── LLM providers (at least one is required) ─────────────────────────────────
# Fallback order: groq -> gemini -> mistral -> huggingface
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

HF_TOKEN=
HF_MODEL=mistral

# ── Respan Gateway (optional in-process routing for /chat) ───────────────────
# Routes chat through the open-source gateway, which forwards to the provider
# named in the model ("groq/openai/gpt-oss-120b") using the keys above. No
# Respan account, hosted credits or tracing are needed.
#   https://github.com/respanai/respan-gateway
GATEWAY_ENABLED=false
# Optional gateway.toml (providers, routes, ...); relative paths resolve from the
# directory uvicorn runs in (backend/).
GATEWAY_CONFIG=
# Model the gateway is asked for. Defaults to "<LLM_PROVIDER>/<its model>".
GATEWAY_MODEL=

# ── Search sources (optional; missing keys simply disable that source) ───────
TAVILY_API_KEY=
SERP_API_KEY=
NEWS_API_KEY=

# ── Supabase authentication (required for signed-in features) ────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: enables offline HS256 verification (skips the network round-trip)
SUPABASE_JWT_SECRET=

# ── Report sharing ───────────────────────────────────────────────────────────
# Random 32+ character secret used to sign read-only share links.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SHARE_SECRET=

# ── ChromaDB RAG (optional cloud mode; local mode needs no keys) ─────────────
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# 64-char hex / base64 / raw 32-byte key. Auto-generated into backend/chroma.key
# when unset.
CHROMA_ENCRYPTION_KEY=

# ── Pipeline defaults ────────────────────────────────────────────────────────
DEFAULT_MAX_REVISIONS=2
DEFAULT_APPROVAL_THRESHOLD=8

# ── Distributed research event transport (TASK 2.5) ─────────────────────────
# Redis Streams are the live/replay transport; PostgreSQL stores the durable
# event journal and run status. Use the same Redis instance as Celery.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Maximum retained events per run; approximate trim (MAXLEN ~).
EVENT_STREAM_MAXLEN=10000
# Idle/completed streams expire after this many seconds.
EVENT_STREAM_TTL_SECONDS=86400
# Replay and live-read bounds protect a slow SSE consumer.
EVENT_STREAM_REPLAY_LIMIT=1000
EVENT_STREAM_READ_COUNT=100
EVENT_STREAM_BLOCK_MS=1000
